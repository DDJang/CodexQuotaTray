<UserControl
    x:Class="CodexQuotaTray.App.Views.QuotaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:CodexQuotaTray.Core.Models"
    xmlns:local="using:CodexQuotaTray.App">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:QuotaToneBrushConverter x:Key="QuotaToneBrushConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Spacing="10">
                <Border
                    Padding="18,7"
                    Background="{ThemeResource BadgeSurfaceBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsPrototype, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        Text="静态演示 · 未连接真实账户"
                        TextAlignment="Center" />
                </Border>

                <Border
                    Padding="16,4"
                    Background="{ThemeResource CardSurfaceBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource QuotaCornerRadius}"
                    Visibility="{Binding HasWindows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{Binding Windows}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:QuotaWindowView">
                                <StackPanel Padding="0,11" Spacing="8">
                                    <Grid>
                                        <TextBlock Style="{StaticResource QuotaNameTextStyle}" Text="{Binding Name}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{Binding Tone, Converter={StaticResource QuotaToneBrushConverter}}"
                                            Style="{StaticResource QuotaPercentTextStyle}"
                                            Text="{Binding PercentText}" />
                                    </Grid>
                                    <ProgressBar
                                        Maximum="100"
                                        Value="{Binding DisplayPercent}"
                                        Foreground="{Binding Tone, Converter={StaticResource QuotaToneBrushConverter}}"
                                        Style="{StaticResource QuotaProgressStyle}" />
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource PrimaryTextBrush}"
                                            FontSize="12"
                                            Text="{Binding ResetRelative}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TertiaryTextBrush}"
                                            FontSize="12"
                                            Text="·" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TertiaryTextBrush}"
                                            FontSize="12"
                                            Text="{Binding ResetAt}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Spacing="10"
            Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsRepeater ItemsSource="{Binding LoadingWindows}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Height="168"
                            Padding="16,15"
                            Background="{ThemeResource CardSurfaceBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource QuotaCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Border
                                        Width="96"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource BadgeSurfaceBrush}"
                                        CornerRadius="4" />
                                    <Border
                                        Width="60"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource BadgeSurfaceBrush}"
                                        CornerRadius="4" />
                                </Grid>
                                <Border
                                    Grid.Row="1"
                                    Height="16"
                                    Margin="0,20,0,0"
                                    Background="{ThemeResource TrackBrush}"
                                    CornerRadius="8" />
                                <Border
                                    Grid.Row="2"
                                    Width="180"
                                    Height="12"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource BadgeSurfaceBrush}"
                                    CornerRadius="4" />
                                <ProgressRing
                                    Grid.RowSpan="3"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsActive="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <Grid
            Grid.Row="1"
            Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Width="170"
                Height="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource BadgeSurfaceBrush}"
                CornerRadius="4" />
            <Border
                Width="72"
                Height="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{ThemeResource BadgeSurfaceBrush}"
                CornerRadius="4" />
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="{Binding ResetCredits.Summary}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <HyperlinkButton
                Grid.Column="1"
                Height="24"
                MinHeight="24"
                Padding="4,1"
                Command="{Binding OpenUsageCommand}"
                Content="官方用量"
                FontSize="12"
                AutomationProperties.Name="打开 Codex 官方用量页面" />
        </Grid>
    </Grid>
</UserControl>

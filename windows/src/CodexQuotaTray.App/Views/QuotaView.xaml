<UserControl
    x:Class="CodexQuotaTray.App.Views.QuotaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:CodexQuotaTray.Core.Models"
    xmlns:local="using:CodexQuotaTray.App">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:QuotaToneBrushConverter x:Key="QuotaToneBrushConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="{Binding ShowQuotaLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <StackPanel Spacing="10">
                <Border
                    Padding="18,7"
                    Background="{ThemeResource BadgeSurfaceBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsPrototype, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        Text="静态演示 · 未连接真实账户"
                        TextAlignment="Center" />
                </Border>

                <Border
                    Padding="16,4"
                    Background="{ThemeResource CardSurfaceBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource QuotaCornerRadius}"
                    Visibility="{Binding HasWindows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{Binding Windows}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:QuotaWindowView">
                                <StackPanel Padding="0,11" Spacing="8">
                                    <Grid>
                                        <TextBlock Style="{StaticResource QuotaNameTextStyle}" Text="{Binding Name}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{Binding Tone, Converter={StaticResource QuotaToneBrushConverter}}"
                                            Style="{StaticResource QuotaPercentTextStyle}"
                                            Text="{Binding PercentText}" />
                                    </Grid>
                                    <ProgressBar
                                        Maximum="100"
                                        Value="{Binding DisplayPercent}"
                                        Foreground="{Binding Tone, Converter={StaticResource QuotaToneBrushConverter}}"
                                        Style="{StaticResource QuotaProgressStyle}" />
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource PrimaryTextBrush}"
                                            FontSize="12"
                                            Text="{Binding ResetRelative}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource TertiaryTextBrush}"
                                            FontSize="12"
                                            Text="·" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource TertiaryTextBrush}"
                                            FontSize="12"
                                            Text="{Binding ResetAt}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Height="168"
            Background="{ThemeResource CardSurfaceBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource QuotaCornerRadius}"
            Visibility="{Binding ShowQuotaLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{Binding ShowQuotaLoading}" />
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Text="{Binding ResetCredits.Summary}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <HyperlinkButton
                Grid.Column="1"
                Height="24"
                MinHeight="24"
                Padding="4,1"
                Command="{Binding OpenUsageCommand}"
                Content="官方用量"
                FontSize="12"
                AutomationProperties.Name="打开 Codex 官方用量页面" />
        </Grid>
    </Grid>
</UserControl>

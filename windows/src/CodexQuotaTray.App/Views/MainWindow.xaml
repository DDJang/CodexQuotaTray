<Window
    x:Class="CodexQuotaTray.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexQuotaTray.App"
    Title="CodexQuotaTray">
    <Grid x:Name="ContentRoot" Background="Transparent">
        <Grid.Resources>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:StatusToneBrushConverter x:Key="StatusToneBrushConverter" />
        </Grid.Resources>

        <Grid x:Name="PanelSurface" Background="{ThemeResource MainWindowSurfaceBrush}">
            <ScrollViewer
                x:Name="PanelScroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalAlignment="Top"
                VerticalContentAlignment="Top"
                VerticalScrollMode="Auto">
                <StackPanel
                    x:Name="PanelContent"
                    Padding="18,14,18,4"
                    Spacing="10"
                    VerticalAlignment="Top">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="HeaderDragRegion"
                            Background="Transparent"
                            ColumnSpacing="8"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource TitleTextStyle}"
                                Text="{Binding Title}" />
                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                Background="{ThemeResource BadgeSurfaceBrush}"
                                CornerRadius="9"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasPlanBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource PanelChromeForegroundBrush}"
                                    Text="{Binding PlanBadge}" />
                            </Border>
                            <TextBlock
                                x:Name="HeaderStatusText"
                                Grid.Column="2"
                                MaxLines="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{Binding StatusTone, Converter={StaticResource StatusToneBrushConverter}}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{Binding StatusText}" />
                        </Grid>

                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Style="{StaticResource RoundIconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="刷新额度"
                            ToolTipService.ToolTip="刷新额度">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonForeground" ResourceKey="PanelChromeForegroundBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="PanelChromeForegroundBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="PanelChromeForegroundBrush" />
                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="PanelChromeForegroundBrush" />
                            </Button.Resources>
                            <Grid>
                                <FontIcon
                                    FontSize="16"
                                    Glyph="&#xE72C;"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                <ProgressRing
                                    Width="18"
                                    Height="18"
                                    Foreground="{ThemeResource PanelChromeForegroundBrush}"
                                    IsActive="{Binding IsRefreshing}"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Border
                        x:Name="TrayFailureBanner"
                        Padding="12,9"
                        Background="{ThemeResource WarningSurfaceBrush}"
                        BorderBrush="{ThemeResource WarningStatusBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource WarningStatusBrush}"
                            Text="⚠ 托盘图标初始化失败，请重新启动应用或从窗口退出。"
                            TextWrapping="Wrap" />
                    </Border>

                    <Border
                        x:Name="TabSelectorSurface"
                        Padding="3"
                        Background="{ThemeResource TabSelectorSurfaceBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <Border.Resources>
                            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="SecondaryTextBrush" />
                            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="SecondaryTextBrush" />
                            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="SecondaryTextBrush" />
                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TabSelectedTextBrush" />
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TabSelectedTextBrush" />
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TabSelectedTextBrush" />
                            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="CardSurfaceBrush" />
                            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="BadgeSurfaceBrush" />
                            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="CardBorderBrush" />
                            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="CardBorderBrush" />
                            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlFillColorTransparentBrush" />
                        </Border.Resources>
                        <Grid x:Name="TabSelectorGrid" ColumnSpacing="3" SizeChanged="OnTabSelectorSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="TabSelectionPill"
                                Grid.Column="0"
                                Height="30"
                                Background="{ThemeResource TabSelectionSurfaceBrush}"
                                CornerRadius="6"
                                IsHitTestVisible="False">
                                <Border.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.18" />
                                </Border.TranslationTransition>
                            </Border>
                            <ToggleButton
                                x:Name="QuotaTabButton"
                                Height="30"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsChecked="True"
                                Click="OnQuotaTabClick"
                                Content="额度"
                                AutomationProperties.Name="显示额度页面" />
                            <ToggleButton
                                x:Name="TokenTabButton"
                                Grid.Column="1"
                                Height="30"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnTokenTabClick"
                                Content="统计"
                                AutomationProperties.Name="显示统计页面" />
                        </Grid>
                    </Border>

                    <Grid x:Name="PageHost" VerticalAlignment="Top">
                        <Grid x:Name="QuotaPageHost" />
                        <Grid x:Name="TokenPageHost" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

<UserControl
    x:Class="CodexQuotaTray.App.Views.QuotaProgressVisual"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="16"
    MinHeight="16"
    HorizontalAlignment="Stretch">
    <Grid
        x:Name="Track"
        Background="{ThemeResource TrackBrush}"
        CornerRadius="{StaticResource QuotaProgressCornerRadius}"
        SizeChanged="OnTrackSizeChanged">
        <Border
            x:Name="Indicator"
            Width="0"
            HorizontalAlignment="Left"
            Background="{x:Bind IndicatorBrush, Mode=OneWay}"
            CornerRadius="{StaticResource QuotaProgressCornerRadius}" />
    </Grid>
</UserControl>

<Window
    x:Class="CodexQuotaTray.App.Views.LightweightPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PanelRoot" Width="280" Background="Transparent">
        <Border x:Name="FallbackSurface" Background="{ThemeResource MenuFallbackSurfaceBrush}" Visibility="Collapsed" />
        <StackPanel Padding="12,8,12,10" Spacing="4">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="轻量模式" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                <ToggleSwitch x:Name="ModeSwitch" Grid.Column="1" MinWidth="0" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="轻量模式" IsOn="True" Toggled="OnModeToggled" />
            </Grid>
            <TextBlock Text="在 ChatGPT 标题栏查看额度。关闭后恢复完整面板。" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>

<Window
    x:Class="CodexQuotaTray.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexQuotaTray.App"
    Title="CodexQuotaTray 设置">
    <Grid
        x:Name="SettingsRoot"
        Background="Transparent">
        <Grid.Resources>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:RefreshModeDisplayConverter x:Key="RefreshModeDisplayConverter" />
            <local:ThemeModeDisplayConverter x:Key="ThemeModeDisplayConverter" />
            <local:QuotaDataSourceDisplayConverter x:Key="QuotaDataSourceDisplayConverter" />
            <local:TokenUsageDataSourceDisplayConverter x:Key="TokenUsageDataSourceDisplayConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="SettingsFallbackSurface"
            Grid.Row="0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            IsHitTestVisible="False" />

        <ContentControl
            x:Name="SettingsPresenter"
            Grid.Row="0"
            Background="Transparent"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <Grid
            x:Name="SettingsPageStore"
            Grid.Row="0"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Target="ReminderSecondaryColumn.Width" Value="0" />
                            <Setter Target="NotifyRemaining20Card.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyRemaining20Card.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyRemaining10Card.(Grid.Row)" Value="2" />
                            <Setter Target="NotifyRemaining10Card.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyAfterResetCard.(Grid.Row)" Value="3" />
                            <Setter Target="NotifyAfterResetCard.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedSecondaryColumn.Width" Value="0" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Row)" Value="1" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedActionsGrid.RowSpacing" Value="8" />
                            <Setter Target="AdvancedTrailingRow2.Height" Value="Auto" />
                            <Setter Target="AdvancedTrailingRow3.Height" Value="Auto" />
                            <Setter Target="AdvancedClearCacheButton.(Grid.Row)" Value="2" />
                            <Setter Target="AdvancedClearCacheButton.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedResetButton.(Grid.Row)" Value="3" />
                            <Setter Target="AdvancedResetButton.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="680" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ReminderSecondaryColumn.Width" Value="*" />
                            <Setter Target="NotifyRemaining20Card.(Grid.Row)" Value="0" />
                            <Setter Target="NotifyRemaining20Card.(Grid.Column)" Value="1" />
                            <Setter Target="NotifyRemaining10Card.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyRemaining10Card.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyAfterResetCard.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyAfterResetCard.(Grid.Column)" Value="1" />
                            <Setter Target="AdvancedSecondaryColumn.Width" Value="*" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Row)" Value="0" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Column)" Value="1" />
                            <Setter Target="AdvancedActionsGrid.RowSpacing" Value="0" />
                            <Setter Target="AdvancedTrailingRow2.Height" Value="0" />
                            <Setter Target="AdvancedTrailingRow3.Height" Value="0" />
                            <Setter Target="AdvancedClearCacheButton.(Grid.Row)" Value="1" />
                            <Setter Target="AdvancedClearCacheButton.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedResetButton.(Grid.Row)" Value="1" />
                            <Setter Target="AdvancedResetButton.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="SettingsContentHost" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1100" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="SettingsContent"
                    HorizontalAlignment="Stretch"
                    Padding="24,0,24,24">

                    <StackPanel x:Name="SettingsHomePanel" Spacing="4">
                        <TextBlock Text="设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <Button Tag="General" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="常规" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="启动、显示方式与额度和统计缓存" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="Sync" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="刷新与同步" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="额度与统计刷新、与手机同步" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="Account" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="账户" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="查看 Codex CLI 与 OAuth 账户状态" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="DataSources" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="数据来源" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="分别选择额度和 Token 使用量来源" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="Appearance" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="个性化" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="应用主题" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="Alerts" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="提醒" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="额度与重置卡提醒" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="Updates" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="更新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="自动检查、提醒与安装选项" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Tag="Advanced" Click="OnSettingsCategoryClick" Style="{StaticResource SettingsCategoryButtonStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="数据与高级选项" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="数据目录、诊断、缓存与重置" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="AboutButton"
                            Tag="About"
                            Click="OnSettingsCategoryClick"
                            Style="{StaticResource SettingsCategoryButtonStyle}"
                            AutomationProperties.Name="关于 CodexQuotaTray">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    x:Name="AboutIconImage"
                                    Width="24"
                                    Height="24"
                                    Source="ms-appx:///Assets/AppIcon.png"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="关于" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock x:Name="AboutHomeDescriptionText" Text="CodexQuotaTray" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="AccountSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="账户" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                        <TextBlock Text="Codex CLI 账户" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="{Binding CliAccountStatusText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="刷新状态" Command="{Binding RefreshAccountStatusCommand}" Style="{StaticResource SettingsActionButtonStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                        <TextBlock Text="OAuth 账户" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="{Binding OAuthAccountStatusText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="登录 OAuth" Command="{Binding LoginOAuthCommand}" Style="{StaticResource SettingsActionButtonStyle}" />
                                        <Button Content="退出登录" Command="{Binding LogoutOAuthCommand}" Style="{StaticResource SettingsActionButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding OAuthUserCodeText}" Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{Binding OAuthVerificationUrl}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                <Button Content="打开设备验证页" Click="OnOpenOAuthVerificationRequested" Style="{StaticResource SettingsActionButtonStyle}" HorizontalAlignment="Left" />
                                <TextBlock Text="设备登录会在外部浏览器完成；应用不会读取浏览器 Cookie。" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DataSourcesSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="数据来源" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <StackPanel Spacing="8">
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                        <TextBlock Text="额度来源" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedQuotaDataSourceDescription}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="176" ItemsSource="{Binding QuotaDataSources}" SelectedItem="{Binding SelectedQuotaDataSource, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource QuotaDataSourceDisplayConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                        <TextBlock Text="Token 使用量来源" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedTokenUsageDataSourceDescription}" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="176" ItemsSource="{Binding TokenUsageDataSources}" SelectedItem="{Binding SelectedTokenUsageDataSource, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TokenUsageDataSourceDisplayConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="切换来源会清除当前页面的旧来源投影，确认后立即刷新新来源。" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                                <Button Content="应用来源" Click="OnApplyDataSourcesRequested" IsEnabled="{Binding CanEditDataSources}" Style="{StaticResource SettingsActionButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="GeneralSettingsPanel" Spacing="8" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="启动" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="开机启动" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="{Binding StartupDescription}" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsEnabled="{Binding CanConfigureStartup}"
                                    AutomationProperties.Name="开机启动"
                                    IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="静默启动" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="开机时只驻留托盘，不主动显示额度面板。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="静默启动"
                                    IsOn="{Binding SilentStartup, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="显示与缓存" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="显示方式" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="选择额度面板显示剩余百分比或使用百分比。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    ItemsSource="{Binding PercentageDisplayModes}"
                                    SelectedItem="{Binding SelectedPercentageDisplayMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="保存额度缓存" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="保存非敏感额度快照，用于启动时快速展示。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="保存额度缓存"
                                    IsOn="{Binding PersistQuotaCache, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="保存统计缓存" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="保存非敏感 Token 统计，用于启动时快速展示。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="保存统计缓存"
                                    IsOn="{Binding PersistTokenUsageCache, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SyncSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="额度" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="刷新频率" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="选择后台自动刷新额度的频率。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    ItemsSource="{Binding RefreshModes}"
                                    SelectedItem="{Binding SelectedRefreshMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource RefreshModeDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="打开面板时刷新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="打开额度面板时刷新最新数据，短时间重复打开会自动去重。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="打开面板时刷新"
                                    IsOn="{Binding RefreshOnPanelOpen, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="网络恢复后刷新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="网络恢复后自动刷新一次额度。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="网络恢复后刷新"
                                    IsOn="{Binding RefreshOnNetworkRestore, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="统计" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="刷新频率" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="定时刷新本机 Codex Token 统计；关闭后仅在手动刷新时刷新。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    ItemsSource="{Binding RefreshModes}"
                                    SelectedItem="{Binding SelectedTokenRefreshMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource RefreshModeDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="打开面板时刷新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="打开主面板时刷新统计，短时间重复打开会自动去重。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    AutomationProperties.Name="打开面板时刷新统计"
                                    IsOn="{Binding TokenRefreshOnPanelOpen, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="与手机同步" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                        <TextBlock Text="与手机同步" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="允许手机端 CodexQuotaTray 通过局域网同步 Token 统计与额度信息。" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="与手机同步"
                                        IsOn="{Binding PhoneTokenSyncEnabled, Mode=TwoWay}"
                                        Style="{StaticResource SettingsToggleSwitchStyle}" />
                                </Grid>
                                <TextBlock Text="{Binding TokenSyncStatusText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock Text="{Binding TokenSyncDeviceNameText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock Text="{Binding TokenSyncAddressText}" Style="{StaticResource SettingsDescriptionStyle}" />
                                <StackPanel x:Name="TokenSyncQrPanel" HorizontalAlignment="Center" Spacing="8">
                                    <Image
                                        x:Name="TokenSyncQrCodeImage"
                                        Width="220"
                                        Height="220"
                                        HorizontalAlignment="Center"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        Text="使用手机端 CodexQuotaTray 扫码配对"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="配对密钥默认隐藏；仅复制到受信任的私人 Wi-Fi 设备。"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="复制配对信息"
                                        Command="{Binding CopyTokenSyncPairingInfoCommand}"
                                        IsEnabled="{Binding PhoneTokenSyncEnabled}"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                    <Button
                                        Content="重新生成密钥"
                                        Click="OnRegenerateTokenSyncSecretRequested"
                                        Style="{StaticResource SettingsActionButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="若手机无法连接，请检查 Windows 防火墙；应用不会自动提权或添加规则。"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSettingsPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="应用主题" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <Grid Style="{StaticResource SettingsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                <TextBlock Text="主题" Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="设置面板和额度窗口的显示主题。" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                Width="176"
                                ItemsSource="{Binding ThemeModes}"
                                SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ThemeModeDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    </StackPanel>

                    <StackPanel x:Name="AlertSettingsPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="额度提醒" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <Grid
                        x:Name="ReminderOptionsGrid"
                        Style="{StaticResource SettingsOperationRowStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ReminderSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="NotifyRemaining50Card"
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource SettingsItemCardStyle}">
                                <CheckBox
                                    x:Name="NotifyRemaining50CheckBox"
                                    Content="剩余 50%"
                                    IsChecked="{Binding NotifyRemaining50, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="NotifyRemaining20Card"
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource SettingsItemCardStyle}">
                                <CheckBox
                                    x:Name="NotifyRemaining20CheckBox"
                                    Content="剩余 20%"
                                    IsChecked="{Binding NotifyRemaining20, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="NotifyRemaining10Card"
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource SettingsItemCardStyle}">
                                <CheckBox
                                    x:Name="NotifyRemaining10CheckBox"
                                    Content="剩余 10%"
                                    IsChecked="{Binding NotifyRemaining10, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="NotifyAfterResetCard"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource SettingsItemCardStyle}">
                                <CheckBox
                                    x:Name="NotifyAfterResetCheckBox"
                                    Content="额度周期重置后提醒"
                                    IsChecked="{Binding NotifyAfterQuotaReset, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />
                            </Border>
                    </Grid>
                    <TextBlock Text="重置卡提醒" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="临期提醒" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="在可用重置卡即将到期时发送通知" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding NotifyResetCreditExpiry, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="提前提醒时间" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="在到期前发送一次提醒" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    SelectedIndex="{Binding SelectedResetCreditExpiryLeadIndex, Mode=TwoWay}"
                                    IsEnabled="{Binding NotifyResetCreditExpiry}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <ComboBoxItem Content="1 天前" />
                                    <ComboBoxItem Content="6 小时前" />
                                    <ComboBoxItem Content="1 小时前" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <StackPanel x:Name="UpdateSettingsPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="更新设置" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <StackPanel Spacing="6">
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="自动检查更新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="启动或回到前台时最多每天检查一次" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding AutomaticUpdateChecksEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding IsWindowsUpdateAvailable}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="更新提醒" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="自动检查发现新版本时提示" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding UpdateRemindersEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding CanEditUpdateReminders}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="下载完成后自动打开安装程序" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="更新包下载并通过校验后自动启动安装程序。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding AutoLaunchInstallerAfterDownload, Mode=TwoWay}"
                                    IsEnabled="{Binding IsWindowsUpdateAvailable}"
                                    Style="{StaticResource SettingsToggleSwitchStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="更新状态" Style="{StaticResource SettingsSectionHeaderStyle}" />
                    <Border Style="{StaticResource SettingsItemCardStyle}">
                        <StackPanel Spacing="6">
                            <Button
                                Content="检查更新"
                                Command="{Binding CheckForWindowsUpdatesCommand}"
                                IsEnabled="{Binding CanCheckForWindowsUpdates}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="当前版本：" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="上次检查：" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock Text="{Binding UpdateLastCheckText}" Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding UpdateStatusText}"
                                Style="{StaticResource SettingsLabelStyle}"
                                Visibility="{Binding HasUpdateStatusText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,2,0,0" />
                            <StackPanel
                                Spacing="4"
                                Visibility="{Binding HasDownloadProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding DownloadProgressSizeText}"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DownloadProgressPercentageText}"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </Grid>
                                <ProgressBar
                                    Maximum="100"
                                    Value="{Binding DownloadProgressValue}"
                                    IsIndeterminate="{Binding IsDownloadProgressIndeterminate}"
                                    Style="{StaticResource QuotaProgressStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="取消"
                                        Command="{Binding CancelWindowsUpdateCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        MinWidth="96" />
                                    <Button
                                        Content="浏览器下载"
                                        Command="{Binding BrowserDownloadWindowsUpdateCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        MinWidth="120" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Spacing="4"
                                Visibility="{Binding CanDownloadWindowsUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="下载并安装"
                                        Click="OnDownloadWindowsUpdateRequested"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        MinWidth="120" />
                                    <Button
                                        Content="浏览器下载"
                                        Command="{Binding BrowserDownloadWindowsUpdateCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        MinWidth="120" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="数据与维护" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Grid
                            x:Name="AdvancedActionsGrid"
                            Style="{StaticResource SettingsOperationRowStyle}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="AdvancedTrailingRow2" Height="Auto" />
                                    <RowDefinition x:Name="AdvancedTrailingRow3" Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="AdvancedSecondaryColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="AdvancedOpenDataButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Content="打开数据目录"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="AdvancedCopyDiagnosticsButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Content="复制诊断信息"
                                    Command="{Binding CopyDiagnosticsCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="AdvancedClearCacheButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Content="清除额度缓存"
                                    Command="{Binding ClearQuotaCacheCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="AdvancedResetButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Content="恢复默认设置"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AboutSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="应用信息" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    x:Name="AboutDetailIconImage"
                                    Width="64"
                                    Height="64"
                                    Source="ms-appx:///Assets/AppIcon.png"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutProductNameText" Text="CodexQuotaTray" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutVersionText" Text="版本" Style="{StaticResource SettingsDescriptionStyle}" />
                                    <TextBlock
                                        Text="只读额度桌面应用，用于查看额度窗口、重置时间、可用重置卡与 Token 统计。不会消耗重置卡或执行账户写操作。"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="链接与许可" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsItemCardStyle}">
                            <StackPanel Spacing="4">
                                <HyperlinkButton Content="GitHub 项目主页" NavigateUri="https://github.com/DDJang/CodexQuotaTray" />
                                <HyperlinkButton Content="开源许可证（MIT）" NavigateUri="https://github.com/DDJang/CodexQuotaTray/blob/main/LICENSE" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>

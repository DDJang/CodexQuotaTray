<Window
    x:Class="CodexQuotaTray.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexQuotaTray 设置">
    <Grid
        x:Name="SettingsRoot"
        Background="{ThemeResource WindowSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarThemeResources"
            Width="0"
            Height="0"
            Visibility="Collapsed">
            <Border x:Name="TitleBarBackgroundResource" Background="{ThemeResource SettingsTitleBarBackgroundBrush}" />
            <Border x:Name="TitleBarForegroundResource" Background="{ThemeResource SettingsTitleBarForegroundBrush}" />
            <Border x:Name="TitleBarButtonBackgroundResource" Background="{ThemeResource SettingsTitleBarButtonBackgroundBrush}" />
            <Border x:Name="TitleBarButtonForegroundResource" Background="{ThemeResource SettingsTitleBarButtonForegroundBrush}" />
            <Border x:Name="TitleBarButtonHoverBackgroundResource" Background="{ThemeResource SettingsTitleBarButtonHoverBackgroundBrush}" />
            <Border x:Name="TitleBarButtonHoverForegroundResource" Background="{ThemeResource SettingsTitleBarButtonHoverForegroundBrush}" />
            <Border x:Name="TitleBarButtonPressedBackgroundResource" Background="{ThemeResource SettingsTitleBarButtonPressedBackgroundBrush}" />
            <Border x:Name="TitleBarButtonPressedForegroundResource" Background="{ThemeResource SettingsTitleBarButtonPressedForegroundBrush}" />
        </Grid>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <StackPanel
                x:Name="HeaderContent"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Padding="24,22,24,12"
                Spacing="8">
                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                <TextBlock
                    Text="设置、额度缓存和提醒防重复状态仅保存在当前用户目录。"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    Opacity="0.86" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="SettingsScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Target="ActionSecondaryColumn.Width" Value="0" />
                            <Setter Target="RefreshUsageButton.(Grid.Row)" Value="1" />
                            <Setter Target="RefreshUsageButton.(Grid.Column)" Value="0" />
                            <Setter Target="CopySummaryButton.(Grid.Row)" Value="2" />
                            <Setter Target="CopySummaryButton.(Grid.Column)" Value="0" />
                            <Setter Target="CopyDiagnosticsButton.(Grid.Row)" Value="3" />
                            <Setter Target="CopyDiagnosticsButton.(Grid.Column)" Value="0" />
                            <Setter Target="ReminderSecondaryColumn.Width" Value="0" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Row)" Value="2" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Row)" Value="3" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="680" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ActionSecondaryColumn.Width" Value="*" />
                            <Setter Target="RefreshUsageButton.(Grid.Row)" Value="0" />
                            <Setter Target="RefreshUsageButton.(Grid.Column)" Value="1" />
                            <Setter Target="CopySummaryButton.(Grid.Row)" Value="1" />
                            <Setter Target="CopySummaryButton.(Grid.Column)" Value="0" />
                            <Setter Target="CopyDiagnosticsButton.(Grid.Row)" Value="1" />
                            <Setter Target="CopyDiagnosticsButton.(Grid.Column)" Value="1" />
                            <Setter Target="ReminderSecondaryColumn.Width" Value="*" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Row)" Value="0" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Column)" Value="1" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid HorizontalAlignment="Stretch">
                <StackPanel
                    x:Name="SettingsContent"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    Padding="24,0,24,24">

                    <TextBlock Text="常规" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="开机启动" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="{Binding StartupDescription}" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsEnabled="{Binding CanConfigureStartup}"
                                    IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                    HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="静默启动" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="开机时只驻留托盘，不主动显示额度面板。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding SilentStartup, Mode=TwoWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="显示剩余百分比" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="在额度面板中优先显示剩余额度。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ShowRemainingPercent, Mode=TwoWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="使用 24 小时制" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="使用 24 小时格式显示重置时间。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding Use24HourTime, Mode=TwoWay}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="刷新与外观" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="刷新间隔" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="选择后台自动获取额度的频率。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="176"
                                    ItemsSource="{Binding RefreshModes}"
                                    SelectedItem="{Binding SelectedRefreshMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="主题" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="设置面板和额度窗口的显示主题。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="176"
                                    ItemsSource="{Binding ThemeModes}"
                                    SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="网络恢复后刷新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="网络恢复后主动重新读取一次额度。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding RefreshOnNetworkRestore, Mode=TwoWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="保存额度缓存" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="保存非敏感额度快照，用于启动时快速展示。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding PersistQuotaCache, Mode=TwoWay}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="额度提醒" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid
                            x:Name="ReminderOptionsGrid"
                            Style="{StaticResource SettingsOperationRowStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ReminderSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="NotifyRemaining50CheckBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="剩余 50%"
                                IsChecked="{Binding NotifyRemaining50, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox
                                x:Name="NotifyRemaining20CheckBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="剩余 20%"
                                IsChecked="{Binding NotifyRemaining20, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox
                                x:Name="NotifyRemaining10CheckBox"
                                Grid.Row="1"
                                Grid.Column="0"
                                Content="剩余 10%"
                                IsChecked="{Binding NotifyRemaining10, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox
                                x:Name="NotifyAfterResetCheckBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Content="额度周期重置后提醒"
                                IsChecked="{Binding NotifyAfterQuotaReset, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <TextBlock Text="快捷操作" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid
                            x:Name="QuickActionsGrid"
                            Style="{StaticResource SettingsOperationRowStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ActionSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="RefreshQuotaButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="刷新额度"
                                Command="{Binding RefreshQuotaCommand}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                x:Name="RefreshUsageButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="打开官方用量页面"
                                Command="{Binding OpenOfficialUsageCommand}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                x:Name="CopySummaryButton"
                                Grid.Row="1"
                                Grid.Column="0"
                                Content="复制额度摘要"
                                Command="{Binding CopyQuotaSummaryCommand}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                x:Name="CopyDiagnosticsButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Content="复制诊断信息"
                                Command="{Binding CopyDiagnosticsCommand}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                        </Grid>
                    </Border>

                    <Button
                        x:Name="AboutButton"
                        Margin="0,16,0,0"
                        Command="{Binding ShowAboutCommand}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="关于 CodexQuotaTray">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关于 CodexQuotaTray" Style="{StaticResource SettingsLabelStyle}" />
                            <FontIcon
                                Grid.Column="1"
                                Glyph="&#xE76C;"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Expander
                        Header="数据与高级选项"
                        IsExpanded="False"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0">
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,0">
                            <StackPanel Spacing="10">
                                <Button
                                    Content="打开数据目录"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    Content="导入 WinUI 预览版数据"
                                    Command="{Binding ImportProductionDataCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Border Style="{StaticResource SettingsRowDividerStyle}" Margin="0,4" />
                                <Button
                                    Content="清除额度缓存"
                                    Command="{Binding ClearQuotaCacheCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid
                x:Name="FooterContent"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Padding="24,12,24,20"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusTextBlock"
                    Grid.Column="0"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SecondaryTextBrush}" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <Button Content="恢复默认设置" Command="{Binding ResetCommand}" />
                    <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window
    x:Class="CodexQuotaTray.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodexQuotaTray 设置">
    <Grid
        x:Name="SettingsRoot"
        Background="{ThemeResource SettingsWindowSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="SettingsScroller"
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ResponsiveStates">
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Target="ReminderSecondaryColumn.Width" Value="0" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Row)" Value="2" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Row)" Value="3" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedSecondaryColumn.Width" Value="0" />
                            <Setter Target="AdvancedImportButton.(Grid.Row)" Value="1" />
                            <Setter Target="AdvancedImportButton.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedCopySummaryButton.(Grid.Row)" Value="2" />
                            <Setter Target="AdvancedCopySummaryButton.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Row)" Value="3" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="680" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ReminderSecondaryColumn.Width" Value="*" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Row)" Value="0" />
                            <Setter Target="NotifyRemaining20CheckBox.(Grid.Column)" Value="1" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyRemaining10CheckBox.(Grid.Column)" Value="0" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Row)" Value="1" />
                            <Setter Target="NotifyAfterResetCheckBox.(Grid.Column)" Value="1" />
                            <Setter Target="AdvancedSecondaryColumn.Width" Value="*" />
                            <Setter Target="AdvancedImportButton.(Grid.Row)" Value="0" />
                            <Setter Target="AdvancedImportButton.(Grid.Column)" Value="1" />
                            <Setter Target="AdvancedCopySummaryButton.(Grid.Row)" Value="1" />
                            <Setter Target="AdvancedCopySummaryButton.(Grid.Column)" Value="0" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Row)" Value="1" />
                            <Setter Target="AdvancedCopyDiagnosticsButton.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid HorizontalAlignment="Stretch">
                <StackPanel
                    x:Name="SettingsContent"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    Padding="24,0,24,24">

                    <TextBlock Text="常规" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="开机启动" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="{Binding StartupDescription}" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsEnabled="{Binding CanConfigureStartup}"
                                    IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="静默启动" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="开机时只驻留托盘，不主动显示额度面板。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding SilentStartup, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="显示剩余百分比" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="在额度面板中优先显示剩余额度。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ShowRemainingPercent, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="使用 24 小时制" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="使用 24 小时格式显示重置时间。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding Use24HourTime, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="刷新与外观" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="刷新间隔" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="选择后台自动获取额度的频率。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="176"
                                    ItemsSource="{Binding RefreshModes}"
                                    SelectedItem="{Binding SelectedRefreshMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="主题" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="设置面板和额度窗口的显示主题。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="176"
                                    ItemsSource="{Binding ThemeModes}"
                                    SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="网络恢复后刷新" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="网络恢复后主动重新读取一次额度。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding RefreshOnNetworkRestore, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Grid Style="{StaticResource SettingsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource SettingsRowTextStyle}">
                                    <TextBlock Text="保存额度缓存" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="保存非敏感额度快照，用于启动时快速展示。" Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding PersistQuotaCache, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="额度提醒" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid
                            x:Name="ReminderOptionsGrid"
                            Style="{StaticResource SettingsOperationRowStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ReminderSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                x:Name="NotifyRemaining50CheckBox"
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="剩余 50%"
                                IsChecked="{Binding NotifyRemaining50, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox
                                x:Name="NotifyRemaining20CheckBox"
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="剩余 20%"
                                IsChecked="{Binding NotifyRemaining20, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox
                                x:Name="NotifyRemaining10CheckBox"
                                Grid.Row="1"
                                Grid.Column="0"
                                Content="剩余 10%"
                                IsChecked="{Binding NotifyRemaining10, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                            <CheckBox
                                x:Name="NotifyAfterResetCheckBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Content="额度周期重置后提醒"
                                IsChecked="{Binding NotifyAfterQuotaReset, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <TextBlock Text="数据与高级选项" Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid
                                x:Name="AdvancedActionsGrid"
                                Style="{StaticResource SettingsOperationRowStyle}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="AdvancedSecondaryColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="AdvancedOpenDataButton"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Content="打开数据目录"
                                    Command="{Binding OpenDataDirectoryCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="AdvancedImportButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Content="导入 WinUI 预览版数据"
                                    Command="{Binding ImportProductionDataCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="AdvancedCopySummaryButton"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Content="复制额度摘要"
                                    Command="{Binding CopyQuotaSummaryCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                                <Button
                                    x:Name="AdvancedCopyDiagnosticsButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Content="复制诊断信息"
                                    Command="{Binding CopyDiagnosticsCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />
                            <Button
                                Content="清除额度缓存"
                                Command="{Binding ClearQuotaCacheCommand}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                Content="恢复默认设置"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Button
                        x:Name="AboutButton"
                        Margin="0,16,0,0"
                        Command="{Binding ShowAboutCommand}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        HorizontalContentAlignment="Stretch"
                        UseSystemFocusVisuals="False"
                        AutomationProperties.Name="关于 CodexQuotaTray">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关于 CodexQuotaTray" Style="{StaticResource SettingsLabelStyle}" />
                            <FontIcon
                                Grid.Column="1"
                                Glyph="&#xE76C;"
                                FontSize="14"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</Window>

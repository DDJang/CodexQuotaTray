<Window
    x:Class="CodexQuotaTray.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:CodexQuotaTray.Core.Models"
    xmlns:local="using:CodexQuotaTray.App"
    Title="CodexQuotaTray">
    <Grid x:Name="ContentRoot" Background="{ThemeResource WindowSurfaceBrush}">
        <Grid.Resources>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:QuotaToneBrushConverter x:Key="QuotaToneBrushConverter" />
            <local:StatusToneBrushConverter x:Key="StatusToneBrushConverter" />
        </Grid.Resources>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Padding="24,20,24,18" Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="32"
                        Height="32"
                        CornerRadius="9"
                        VerticalAlignment="Top">
                        <Image
                            Source="/Assets/AppIcon.png"
                            Stretch="Uniform"
                            AutomationProperties.Name="CodexQuotaTray 应用图标" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource TitleTextStyle}" Text="{Binding Title}" />
                            <Border
                                Padding="8,3"
                                Background="{ThemeResource BadgeSurfaceBrush}"
                                CornerRadius="8"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasPlanBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentQuotaBrush}"
                                    Text="{Binding PlanBadge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{Binding StatusTone, Converter={StaticResource StatusToneBrushConverter}}"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource RoundIconButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="刷新额度"
                        ToolTipService.ToolTip="刷新额度">
                        <Grid>
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE72C;"
                                Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                            <ProgressRing
                                Width="18"
                                Height="18"
                                IsActive="{Binding IsRefreshing}"
                                Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                </Grid>

                <Border
                    Padding="18,7"
                    Background="{ThemeResource BadgeSurfaceBrush}"
                    CornerRadius="10"
                    Visibility="{Binding IsPrototype, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        Text="静态 WinUI 原型 · 未连接真实账户或本地配置"
                        TextAlignment="Center" />
                </Border>

                <Border
                    Padding="20,6"
                    Background="{ThemeResource CardSurfaceBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Visibility="{Binding HasWindows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{Binding Windows}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:QuotaWindowView">
                                <StackPanel Padding="0,14" Spacing="10">
                                    <Grid>
                                        <TextBlock
                                            Style="{StaticResource QuotaNameTextStyle}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{Binding Tone, Converter={StaticResource QuotaToneBrushConverter}}"
                                            Style="{StaticResource QuotaPercentTextStyle}"
                                            Text="{Binding PercentText}" />
                                    </Grid>
                                    <ProgressBar
                                        Maximum="100"
                                        Value="{Binding DisplayPercent}"
                                        Foreground="{Binding Tone, Converter={StaticResource QuotaToneBrushConverter}}"
                                        Style="{StaticResource QuotaProgressStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource PrimaryTextBrush}"
                                            FontSize="13"
                                            Text="{Binding ResetRelative}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{Binding ResetAt}" />
                                    </Grid>
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerBrush}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="15"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Glyph="&#xE823;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text="{Binding ResetCredits.Summary}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="8,4"
                        Command="{Binding OpenUsageCommand}"
                        Content="官方用量页面 ↗"
                        FontSize="12"
                        AutomationProperties.Name="打开官方用量页面" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
